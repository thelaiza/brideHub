datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses  Expense[]
  vendors   Vendor[]
  tasks     Task[]
  wedding   Wedding?

  @@map("users")
}

model Wedding {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bride     String
  groom     String
  date      DateTime
  venue     String
  budget    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("weddings")
}

model Expense {
  id        String   @id @default(uuid())
  title     String
  category  String
  amount    Float
  dueDate   DateTime?
  status    String   @default("pending") // pending, paid
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
}

model Vendor {
  id        String   @id @default(uuid())
  name      String
  category  String
  phone     String?
  status    String   @default("contracted") // contracted, pending, etc.
  cost      Float    @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendors")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?  
  completed   Boolean  @default(false)
  dueDate     DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tasks")
}