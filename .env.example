# Configurações da Base de Dados (PostgreSQL)
# Gere a senha sem caracteres especiais (@, :, /, #) para não quebrar a URL: openssl rand -hex 24
POSTGRES_USER=seu_usuario_postgres
POSTGRES_PASSWORD=sua_senha_segura_sem_caracteres_especiais
POSTGRES_DB=bridehub_db

# Segurança e Autenticação do Backend
JWT_SECRET=sua_chave_jwt_super_secreta_e_complexa_aqui

# Portas dos Serviços e Contêineres
API_PORT=3333
WEB_PORT=8080
GRAFANA_PASSWORD=sua_senha_grafana_aqui

# Variáveis do Frontend (Vite)
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=seu_google_client_id_aqui.apps.googleusercontent.com

# CORS (obrigatório para o Docker Compose; em produção use https://seu-dominio)
CORS_ORIGINS=http://localhost:8080

# Variáveis para o serviço de envio de e-mails (Resend) e recuperação de senha
RESEND_API_KEY="sua_chave_de_api_resend_aqui"
RESEND_FROM="BrideHub <onboarding@resend.dev>"
FRONTEND_URL="http://localhost:8080"